{
  "expo": {
    "name": "Kwick",
    "slug": "mao-segura",
    "version": "0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "maosegura",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maosegura.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.maosegura.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "androidStatusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite carregar uma fotografia para o perfil de Trabalhador ou Empregador no Kwick.",
          "cameraPermission": "Permite tirar uma nova fotografia com a câmera para atribuir ao seu perfil.",
          "microphonePermission": "Permite o acesso ao microfone ao gravar imagens em movimento."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "extra": {},
      "eas": {
        "projectId": "a0db921b-0188-490f-93b7-561e98a16fb1"
      }
    }
  }
}
